# =====================================================================
# EFFIADMI - Archivo de ejemplo para DESPLIEGUE EN PRODUCCION
# ---------------------------------------------------------------------
# 1. Copia este archivo como .env  (cp .env.example .env)
# 2. Completa cada valor. NUNCA subas .env a git (ya esta en .gitignore).
# 3. Genera la SECRET_KEY con:
#      python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =====================================================================

# --- Seguridad basica -------------------------------------------------
# DEBUG=0 en produccion. Si falta la variable, la app arranca CON DEBUG
# apagado (fail-closed). Con DEBUG=1 nunca despliegues: expone rutas,
# settings y variables en los stack traces.
DEBUG=0

# Obligatoria con DEBUG=0 (minimo 50 caracteres; si falta o es corta, la
# app no arranca).
SECRET_KEY=

# Dominios aceptados. Obligatoria con DEBUG=0.
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
ALLOWED_HOSTS=

# --- HTTPS / proxy ----------------------------------------------------
# 1 si hay nginx/Caddy/ALB delante reescribiendo X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=0
# 1 solo si hay un proxy de confianza que SOBRESCRIBE X-Forwarded-For en cada
# peticion. Con 0 (default) la IP del cliente es REMOTE_ADDR y el header se
# ignora: si lo activas sin proxy real, un atacante puede rotar el header y
# evadir el limite de intentos de login.
TRUST_X_FORWARDED_FOR=0
# 1 solo si el sitio ya responde por HTTPS (si no, todo redirige a https
# y la pagina no carga).
SECURE_SSL_REDIRECT=0
# Segundos de HSTS. Activar (ej. 31536000) una vez confirme que HTTPS
# funciona en todos los subdominios. Siempre sobre HTTPS.
SECURE_HSTS_SECONDS=0

# Minutos de vida de la sesion (por defecto 12 h).
SESSION_COOKIE_AGE=43200

# --- Estaticos --------------------------------------------------------
# whitenoise sirve /static/ desde staticfiles/; ejecuta antes:
#   python manage.py collectstatic --noinput

# --- Base de datos ----------------------------------------------------
# Sin nada configurado usa SQLite (db.sqlite3). Con DB_ENGINE=postgres usa
# Postgres/Supabase. Requiere el driver 'psycopg[binary]' (ya en requirements).
#
# Supabase -> Project Settings > Database > Connection string:
#   * Host del POOLER: aws-0-<region>.pooler.supabase.com
#   * Usuario:         postgres.<project-ref>
#   * Nombre BD:       postgres
#   * Puerto:          6543 (pooler transaccion) o 5432 (directa)
# DB_ENGINE=postgres
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60
# Con el pooler en modo transaccion (6543) descomenta esto:
# DB_DISABLE_SERVER_SIDE_CURSORS=1
#
# Migrar datos desde otro equipo/BD:
#   python manage.py exportar_respaldo respaldo.json   (siempre en UTF-8)
#   python manage.py migrate
#   python manage.py restaurar_respaldo respaldo.json
# No uses 'manage.py dumpdata --output' en Windows: escribe con la codificacion
# del sistema y 'loaddata' falla con UnicodeDecodeError.
#
# Tests: 'manage.py test' corre SIEMPRE en SQLite (en memoria, no toca
# db.sqlite3 ni la BD remota), aunque DB_ENGINE=postgres. Para forzar la suite
# contra Postgres (crea/borra una BD 'test_postgres'):
#   TEST_DB_ENGINE=postgres python manage.py test

# --- Cache ------------------------------------------------------------
# Sin configurar usa locmem (una sola instancia). Con varios workers o
# servidores define Redis para compartir los limites de throttling/login.
# Requiere el paquete 'redis' instalado.
# CACHE_URL=redis://127.0.0.1:6379/0

# --- Correo SMTP ------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EFFIADMI <no-responder@tudominio.com>

# Valida por DNS que el dominio del correo exista antes de guardarlo o
# iniciar sesion. Pon 0 para validar solo el formato.
# VALIDAR_DOMINIO_CORREO=1

# --- API / Gemini -----------------------------------------------------
GEMINI_API_KEY=

# --- CORS (orignes exactos, vacio = ninguno) --------------------------
# CORS_ALLOWED_ORIGINS=https://tudominio.com

# --- Throttling DRF (opcional; defaults: 60/min anon, 600/min user,
#     20/min IA) --------------------------------------------------------
# THROTTLE_ANON=60/minute
# THROTTLE_USER=600/minute
# THROTTLE_IA=20/minute

# --- Logging ----------------------------------------------------------
# DJANGO_LOG_LEVEL=INFO
# Log a archivo con rotacion (opcional). Ejemplo:
# LOG_FILE=/var/log/effiadmi/app.log
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5
