# =====================================================================
# EFFIADMI - Archivo de ejemplo para DESPLIEGUE EN PRODUCCION
# ---------------------------------------------------------------------
# 1. Copia este archivo como .env  (cp .env.example .env)
# 2. Completa cada valor. NUNCA subas .env a git (ya esta en .gitignore).
# 3. Genera la SECRET_KEY con:
#      python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =====================================================================

# --- Seguridad basica -------------------------------------------------
# DEBUG=0 en produccion. Si falta la variable, la app arranca CON DEBUG
# apagado (fail-closed). Con DEBUG=1 nunca despliegues: expone rutas,
# settings y variables en los stack traces.
DEBUG=0

# Obligatoria con DEBUG=0 (minimo 50 caracteres; si falta o es corta, la
# app no arranca).
SECRET_KEY=

# Dominios aceptados. Obligatoria con DEBUG=0.
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
ALLOWED_HOSTS=

# --- HTTPS / proxy ----------------------------------------------------
# 1 si hay nginx/Caddy/ALB delante reescribiendo X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=0
# 1 solo si el sitio ya responde por HTTPS (si no, todo redirige a https
# y la pagina no carga).
SECURE_SSL_REDIRECT=0
# Segundos de HSTS. Activar (ej. 31536000) una vez confirme que HTTPS
# funciona en todos los subdominios. Siempre sobre HTTPS.
SECURE_HSTS_SECONDS=0

# Minutos de vida de la sesion (por defecto 12 h).
SESSION_COOKIE_AGE=43200

# --- Estaticos --------------------------------------------------------
# whitenoise sirve /static/ desde staticfiles/; ejecuta antes:
#   python manage.py collectstatic --noinput

# --- Base de datos ----------------------------------------------------
# SQLite viene configurada. Para Postgres define DATABASE_URL y agrega
# dj-database-url + psycopg[binary] a requirements.txt.

# --- Correo SMTP ------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EFFIADMI <no-responder@tudominio.com>

# --- API / Gemini -----------------------------------------------------
GEMINI_API_KEY=

# --- CORS (orignes exactos, vacio = ninguno) --------------------------
# CORS_ALLOWED_ORIGINS=https://tudominio.com

# --- Throttling DRF (opcional; defaults: 60/min anon, 600/min user,
#     20/min IA) --------------------------------------------------------
# THROTTLE_ANON=60/minute
# THROTTLE_USER=600/minute
# THROTTLE_IA=20/minute

# --- Logging ----------------------------------------------------------
# DJANGO_LOG_LEVEL=INFO
