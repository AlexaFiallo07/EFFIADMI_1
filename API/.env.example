# Copia este archivo como .env y completa los valores

# Cadena de conexion a MongoDB Atlas (pestaña Connect > Connect your application)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/

# Nombre de la base de datos dentro de Atlas
DATABASE_NAME=effiadmi

# Clave secreta para firmar los tokens JWT (cambiala por una frase larga)
SECRET_KEY=cambia-esta-clave-secreta

# Minutos que dura el token de sesion
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Clave de la API de OpenAI (platform.openai.com > API keys)
OPENAI_API_KEY=sk-...
